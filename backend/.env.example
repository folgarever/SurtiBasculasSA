PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=defaultdb
# SSL de MySQL:
# - En hosts remotos SSL está siempre activo (comportamiento original del proyecto).
# - En localhost se activa solo si DB_SSL=true.
# rejectUnauthorized=false por compatibilidad con certificados autofirmados.
# Cambialo a true solo si tu proveedor usa un certificado válido y quieres verificarlo.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
TZ=America/Guatemala
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
# Orígenes permitidos por CORS, separados por comas. Si se omite: localhost:4200 y surtibasculas.vercel.app.
CORS_ORIGINS=http://localhost:4200,https://surtibasculas.vercel.app
